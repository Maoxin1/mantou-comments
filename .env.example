# Documentation only; there is intentionally no enable switch in index.cjs.
# Do not enter real credentials in chat or this template.
# PostgreSQL connection, explicit JWT secret and private administrator bootstrap
# require a separately authorized secure setup and isolated real-DB verification.
COMMENT_AUDIT=true
LOGIN=disable
DISABLE_USERAGENT=true
DISABLE_REGION=true
DISABLE_AUTHOR_NOTIFY=true
AKISMET_KEY=false
# SMTP_*, WEBHOOK and push channels must remain unset for this candidate.
